
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1120">
  <title>Login | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-50 text-slate-800">

  <%- include("../partials/navbar") %>

  <main class="relative isolate flex min-h-[78vh] items-center justify-center overflow-hidden px-4 py-12 sm:py-16">

    <!-- Decorative background -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-24 left-1/4 size-72 rounded-full bg-indigo-200/40 blur-3xl"></div>
      <div class="absolute -bottom-24 right-1/4 size-72 rounded-full bg-violet-200/40 blur-3xl"></div>
    </div>

    <section class="w-full max-w-md">

      <!-- Heading -->
      <div class="mb-7 text-center">
        <span class="mx-auto mb-5 flex size-14 items-center justify-center rounded-2xl bg-linear-to-br from-indigo-600 to-violet-600 text-2xl font-black text-white shadow-lg shadow-indigo-200">
          J
        </span>

        <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.22em] text-indigo-600">
          Welcome Back
        </p>

        <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
          Login to JobNest
        </h1>

        <p class="mt-3 text-sm leading-6 text-slate-500">
          Your next opportunity is waiting. Pick up where you left off.
        </p>
      </div>

      <!-- Login card -->
      <div class="rounded-3xl border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/70 sm:p-8">

        <% if (typeof query !== "undefined" && query.verifyEmail === "sent") { %>
          <div class="mb-5 rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-sm leading-6 text-indigo-800" role="status">
            Email verification was part of the previous signup flow. You can now log in using your account credentials.
          </div>
        <% } %>

        <% if (typeof query !== "undefined" && query.verified === "1") { %>
          <div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm leading-6 text-emerald-800" role="status">
            Email verified successfully! You can now log in to JobNest.
          </div>
        <% } %>

        <% if (typeof query !== "undefined" && query.registered === "1") { %>
          <div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm leading-6 text-emerald-800" role="status">
            Account created successfully! Log in to continue.
          </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-5">

          <div>
            <label for="email" class="mb-2 block text-sm font-bold text-slate-700">
              Email address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
            >
          </div>

          <div>
            <label for="password" class="mb-2 block text-sm font-bold text-slate-700">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Enter your password"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
            >
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-linear-to-r from-indigo-600 to-violet-600 px-4 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0"
          >
            Login to your account
          </button>

        </form>

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs font-medium text-slate-400">NEW TO JOBNEST?</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <p class="text-center text-sm text-slate-600">
          Don't have an account?
          <a href="/signup" class="font-extrabold text-indigo-600 transition hover:text-violet-700">
            Create account
          </a>
        </p>

      </div>

      <p class="mt-6 text-center text-xs text-slate-400">
        Find your future. Build your career with JobNest.
      </p>

    </section>
  </main>

  <%- include("../partials/footer") %>

</body>
</html>
