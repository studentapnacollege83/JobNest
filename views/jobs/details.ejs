
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= job.title %> | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">

  <%- include("../partials/navbar") %>

  <!-- Premium Hero -->
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-linear-to-br from-indigo-600/25 via-slate-950 to-blue-600/20"></div>
    <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-blue-500/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">

      <a href="/jobs"
         class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white">
        <span aria-hidden="true">←</span>
        Back to Jobs
      </a>

      <div class="mt-9 flex flex-col gap-6 sm:flex-row sm:items-start">

        <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl border border-white/10 bg-white/10 text-3xl font-bold text-white shadow-lg">
          <%= job.companyName ? job.companyName.charAt(0).toUpperCase() : "J" %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1.5 text-xs font-semibold text-emerald-300">
              <%= job.status || "Active" %>
            </span>

            <% if (job.jobType) { %>
              <span class="rounded-full border border-indigo-300/20 bg-indigo-400/10 px-3 py-1.5 text-xs font-semibold text-indigo-200">
                <%= job.jobType %>
              </span>
            <% } %>

            <% if (job.workMode) { %>
              <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300">
                <%= job.workMode %>
              </span>
            <% } %>
          </div>

          <h1 class="mt-5 wrap-break-word text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            <%= job.title %>
          </h1>

          <p class="mt-3 wrap-break-word text-lg font-semibold text-indigo-200">
            <%= job.companyName %>
          </p>

          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm text-slate-300">
            <% if (job.location) { %>
              <span class="inline-flex items-center gap-2">
                <span aria-hidden="true">📍</span>
                <span class="wrap-break-word"><%= job.location %></span>
              </span>
            <% } %>

            <% if (job.experienceLevel) { %>
              <span class="inline-flex items-center gap-2">
                <span aria-hidden="true">✦</span>
                <%= job.experienceLevel %>
              </span>
            <% } %>

            <% if (job.createdAt) { %>
              <span class="inline-flex items-center gap-2">
                <span aria-hidden="true">◷</span>
                Posted <%= new Date(job.createdAt).toLocaleDateString("en-IN", {
                  day: "numeric",
                  month: "short",
                  year: "numeric"
                }) %>
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <% if (isJobSeeker) { %>
          <a href="#apply"
             class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-indigo-700 shadow-lg transition hover:bg-indigo-50">
            Apply for this job <span aria-hidden="true">→</span>
          </a>
        <% } else if (!currentUser) { %>
          <a href="#apply"
             class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-indigo-700 shadow-lg transition hover:bg-indigo-50">
            Login to Apply <span aria-hidden="true">→</span>
          </a>
        <% } %>

        <a href="/jobs"
           class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
          Explore more jobs
        </a>
      </div>

    </div>
  </section>

  <!-- Main Content -->
  <main class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-14">

    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3">

      <!-- Job Description -->
      <div class="min-w-0 space-y-7 lg:col-span-2">

        <!-- Overview -->
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-xl">
              ✦
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
                Job overview
              </p>
              <h2 class="mt-1 text-xl font-bold text-slate-900">
                About this opportunity
              </h2>
            </div>
          </div>

          <div class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2">

            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-sm font-medium text-slate-500">Salary</p>
              <p class="mt-2 wrap-break-word text-lg font-bold text-slate-900">
                <%= job.salary || "Not disclosed" %>
              </p>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-sm font-medium text-slate-500">Employment type</p>
              <p class="mt-2 wrap-break-word text-lg font-bold text-slate-900">
                <%= job.jobType || "Not specified" %>
              </p>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-sm font-medium text-slate-500">Work arrangement</p>
              <p class="mt-2 wrap-break-word text-lg font-bold text-slate-900">
                <%= job.workMode || "Not specified" %>
              </p>
            </div>

            <div class="rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-sm font-medium text-slate-500">Experience level</p>
              <p class="mt-2 wrap-break-word text-lg font-bold text-slate-900">
                <%= job.experienceLevel || "Not specified" %>
              </p>
            </div>

          </div>
        </section>

        <!-- Description -->
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-xl">
              📋
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
                The role
              </p>
              <h2 class="mt-1 text-xl font-bold text-slate-900">
                About the Job
              </h2>
            </div>
          </div>

          <p class="mt-6 wrap-break-word whitespace-pre-line text-sm leading-7 text-slate-600"><%= job.description || "No job description has been provided." %></p>
        </section>

        <!-- Requirements -->
        <% if (job.requirements) { %>
          <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-xl">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
                  What you need
                </p>
                <h2 class="mt-1 text-xl font-bold text-slate-900">
                  Requirements
                </h2>
              </div>
            </div>

            <p class="mt-6 wrap-break-word whitespace-pre-line text-sm leading-7 text-slate-600"><%= job.requirements %></p>
          </section>
        <% } %>

        <!-- Skills -->
        <% if (job.skills && job.skills.length > 0) { %>
          <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-xl">
                ⚡
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
                  Your toolkit
                </p>
                <h2 class="mt-1 text-xl font-bold text-slate-900">
                  Skills &amp; Expertise
                </h2>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2.5">
              <% job.skills.forEach((skill) => { %>
                <span class="max-w-full wrap-break-word rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-2.5 text-sm font-semibold text-indigo-700">
                  <%= skill %>
                </span>
              <% }) %>
            </div>
          </section>
        <% } %>

      </div>

      <!-- Sidebar -->
      <aside class="min-w-0 space-y-6 lg:sticky lg:top-6">

        <!-- Apply Card -->
        <section id="apply" class="scroll-mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5 sm:p-7">

          <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
            Take the next step
          </p>

          <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">
            Ready to apply?
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-500">
            Take the next step towards your career goals with this opportunity.
          </p>

          <% if (isJobSeeker) { %>

            <% if (applicationSuccess) { %>
              <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
                <p class="font-bold text-emerald-800">
                  ✓ Application submitted!
                </p>
                <p class="mt-1 text-sm leading-6 text-emerald-700">
                  Your application was submitted successfully.
                </p>
              </div>
            <% } else { %>
              <form action="/jobs/<%= job._id %>/apply" method="POST" class="mt-6">
                <button type="submit"
                        class="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700">
                  Apply Now <span aria-hidden="true">→</span>
                </button>
              </form>
            <% } %>

            <p class="mt-4 text-center text-xs leading-5 text-slate-400">
              Make your next career move with JobNest.
            </p>

          <% } else if (!currentUser) { %>

            <a href="/login"
               class="mt-6 flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700">
              Login to Apply <span aria-hidden="true">→</span>
            </a>

            <p class="mt-4 text-center text-sm text-slate-500">
              New to JobNest?
              <a href="/signup" class="font-semibold text-indigo-600 hover:text-indigo-800">
                Create an account
              </a>
            </p>

          <% } else { %>

            <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <p class="font-semibold text-slate-800">
                You are viewing this job as an employer.
              </p>
              <p class="mt-2 text-sm leading-6 text-slate-500">
                Job applications are available to job seekers.
              </p>
            </div>

          <% } %>

        </section>

        <!-- Company Card -->
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">
            About the employer
          </p>

          <div class="mt-5 flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-2xl font-bold text-indigo-700 ring-1 ring-indigo-100">
              <%= job.companyName ? job.companyName.charAt(0).toUpperCase() : "J" %>
            </div>

            <div class="min-w-0">
              <h3 class="wrap-break-word font-bold text-slate-900">
                <%= job.companyName || "Company not specified" %>
              </h3>
              <% if (job.postedBy && job.postedBy.fullName) { %>
                <p class="mt-1 wrap-break-word text-sm text-slate-500">
                  Posted by <%= job.postedBy.fullName %>
                </p>
              <% } %>
            </div>
          </div>

          <div class="mt-5 border-t border-slate-100 pt-4">
            <p class="text-sm leading-6 text-slate-500">
              Review the role details and requirements carefully before applying.
            </p>
          </div>
        </section>

        <!-- Back Link -->
        <a href="/jobs"
           class="flex min-h-12 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
          <span aria-hidden="true">←</span>
          Browse all jobs
        </a>

      </aside>
    </div>
  </main>

  <%- include("../partials/footer") %>

</body>
</html>
