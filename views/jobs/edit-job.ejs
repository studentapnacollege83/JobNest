
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Job | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
  <%- include("../partials/navbar") %>

  <main class="min-h-screen px-4 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto max-w-4xl">

      <a href="/employer/dashboard"
         class="text-sm font-semibold text-indigo-300 transition hover:text-indigo-200">
        ← Back to Dashboard
      </a>

      <section class="relative mt-6 overflow-hidden rounded-3xl border border-indigo-400/20 bg-linear-to-br from-indigo-950 via-slate-900 to-violet-950 p-6 shadow-2xl sm:p-9">
        <div class="pointer-events-none absolute -right-16 -top-20 size-56 rounded-full bg-indigo-500/10 blur-3xl"></div>

        <div class="relative">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-indigo-300">
            Employer Workspace
          </p>

          <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Edit Job
          </h1>

          <p class="mt-3 text-sm leading-7 text-slate-300">
            Update your job details and keep your opportunity up to date.
          </p>
        </div>
      </section>

      <section class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/80 p-5 shadow-xl sm:p-8">

        <form action="/employer/jobs/<%= job._id %>/edit"
              method="POST"
              class="space-y-6">

          <div>
            <label for="title" class="mb-2 block text-sm font-semibold text-slate-200">
              Job Title *
            </label>
            <input id="title" name="title" required maxlength="120"
                   value="<%= job.title %>"
                   placeholder="e.g. Full Stack Developer"
                   class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20">
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="companyName" class="mb-2 block text-sm font-semibold text-slate-200">
                Company Name *
              </label>
              <input id="companyName" name="companyName" required
                     value="<%= job.companyName %>"
                     class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
            </div>

            <div>
              <label for="location" class="mb-2 block text-sm font-semibold text-slate-200">
                Location *
              </label>
              <input id="location" name="location" required
                     value="<%= job.location %>"
                     placeholder="e.g. Jaipur, Rajasthan"
                     class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="jobType" class="mb-2 block text-sm font-semibold text-slate-200">
                Job Type *
              </label>
              <select id="jobType" name="jobType" required
                      class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
                <% ["Full-time", "Part-time", "Internship", "Contract"].forEach((option) => { %>
                  <option value="<%= option %>" <%= job.jobType === option ? "selected" : "" %>>
                    <%= option %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="workMode" class="mb-2 block text-sm font-semibold text-slate-200">
                Work Mode *
              </label>
              <select id="workMode" name="workMode" required
                      class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
                <% ["On-site", "Remote", "Hybrid"].forEach((option) => { %>
                  <option value="<%= option %>" <%= job.workMode === option ? "selected" : "" %>>
                    <%= option %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="experienceLevel" class="mb-2 block text-sm font-semibold text-slate-200">
                Experience Level *
              </label>
              <select id="experienceLevel" name="experienceLevel" required
                      class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
                <% ["Fresher", "Entry-level", "Experienced"].forEach((option) => { %>
                  <option value="<%= option %>" <%= job.experienceLevel === option ? "selected" : "" %>>
                    <%= option %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="salary" class="mb-2 block text-sm font-semibold text-slate-200">
                Salary
              </label>
              <input id="salary" name="salary"
                     value="<%= job.salary || '' %>"
                     placeholder="e.g. ₹3–5 LPA"
                     class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
            </div>
          </div>

          <div>
            <label for="skills" class="mb-2 block text-sm font-semibold text-slate-200">
              Required Skills
            </label>
            <input id="skills" name="skills"
                   value="<%= (job.skills || []).join(', ') %>"
                   placeholder="JavaScript, Node.js, MongoDB"
                   class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-indigo-400">
            <p class="mt-2 text-xs text-slate-400">Separate skills with commas.</p>
          </div>

          <div>
            <label for="description" class="mb-2 block text-sm font-semibold text-slate-200">
              Job Description *
            </label>
            <textarea id="description" name="description" required rows="6"
                      class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"><%= job.description %></textarea>
          </div>

          <div>
            <label for="requirements" class="mb-2 block text-sm font-semibold text-slate-200">
              Requirements
            </label>
            <textarea id="requirements" name="requirements" rows="4"
                      placeholder="Qualifications and other requirements..."
                      class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"><%= job.requirements || "" %></textarea>
          </div>

          <div class="flex flex-col gap-3 border-t border-slate-800 pt-6 sm:flex-row">
            <button type="submit"
                    class="inline-flex items-center justify-center rounded-xl bg-indigo-500 px-6 py-3 font-semibold text-white shadow-lg shadow-indigo-950/30 transition hover:bg-indigo-400">
              Save Changes →
            </button>

            <a href="/employer/dashboard"
               class="inline-flex items-center justify-center rounded-xl border border-slate-700 px-6 py-3 font-semibold text-slate-300 transition hover:bg-slate-800 hover:text-white">
              Cancel
            </a>
          </div>

        </form>
      </section>
    </div>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>
