
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Explore Jobs | JobNest</title>
  <link rel="stylesheet" href="/output.css" />
</head>

<body class="min-h-screen bg-slate-50 text-slate-800">
  <%- include("../partials/navbar") %>

  <!-- Premium Hero -->
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-linear-to-br from-indigo-600/30 via-slate-950 to-blue-600/20"></div>
    <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-16 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium text-indigo-200">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Your next opportunity starts here
        </span>

        <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          <%= category
            ? "Explore " + category.charAt(0).toUpperCase() + category.slice(1) + " Jobs"
            : type
              ? "Explore " + type + " Opportunities"
              : "Find work that moves you forward." %>
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
          Discover opportunities, explore new career paths, and find a role
          that matches your skills and ambitions.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/jobs"
             class="rounded-xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-indigo-50">
            Explore all jobs
          </a>
        <a
  type="button"
  href="/"
  class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
>
  <span aria-hidden="true">←</span>
  Go Back
        </a>
          <% if (!currentUser) { %>
            <a href="/signup"
               class="rounded-xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
              Create an account
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">

    <!-- Search and Filters -->
    <section class="relative z-10 -mt-20 rounded-3xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5 sm:p-7">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">
          Job search
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
          Find your perfect match
        </h2>
        <p class="mt-2 text-sm text-slate-500">
          Use the filters below to narrow down your search.
        </p>
      </div>

      <form action="/jobs" method="GET"
            class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">

        <div>
          <div>
  <label
    for="search"
    class="mb-2 block text-sm font-semibold text-slate-700"
  >
    Keywords
  </label>

  <input
    id="search"
    name="search"
    type="text"
    value="<%= search || '' %>"
    placeholder="Job title or company"
    class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"/>
         </div>  
         <label for="category" class="mb-2 block text-sm font-semibold text-slate-700">
            Category
          </label>
          <select id="category" name="category"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
            <option value="">All categories</option>
            <option value="development" <%= category === "development" ? "selected" : "" %>>Development</option>
            <option value="design" <%= category === "design" ? "selected" : "" %>>Design &amp; Creative</option>
            <option value="marketing" <%= category === "marketing" ? "selected" : "" %>>Marketing</option>
          </select>
        </div>

        <div>
          <label for="type" class="mb-2 block text-sm font-semibold text-slate-700">
            Job type
          </label>
          <select id="type" name="type"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
            <option value="">All job types</option>
            <option value="Full-time" <%= type === "Full-time" ? "selected" : "" %>>Full-time</option>
            <option value="Part-time" <%= type === "Part-time" ? "selected" : "" %>>Part-time</option>
            <option value="Internship" <%= type === "Internship" ? "selected" : "" %>>Internship</option>
            <option value="Contract" <%= type === "Contract" ? "selected" : "" %>>Contract</option>
          </select>
        </div>

        <div>
          <label for="location" class="mb-2 block text-sm font-semibold text-slate-700">
            Location
          </label>
          <input id="location" name="location" type="text"
                 value="<%= location || '' %>"
                 placeholder="City or remote"
                 class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" />
        </div>

        <div>
          <label for="sort" class="mb-2 block text-sm font-semibold text-slate-700">
            Sort by
          </label>
          <select id="sort" name="sort"
                  class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
            <option value="latest" <%= sort !== "oldest" ? "selected" : "" %>>Latest first</option>
            <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>Oldest first</option>
          </select>
        </div>

        <div class="flex items-end gap-3">
          <button type="submit"
                  class="min-h-12 flex-1 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700">
            Search jobs
          </button>
          <a href="/jobs"
             class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-600 transition hover:bg-slate-100"
             title="Clear filters">
            Reset
          </a>
        </div>
      </form>
    </section>

    <!-- Results Heading -->
    <section class="mt-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">
            Opportunities
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            Explore available jobs
          </h2>
          <p class="mt-2 text-sm text-slate-500">
            <span class="font-semibold text-slate-800"><%= totalJobs %></span>
            <%= totalJobs === 1 ? " opportunity" : " opportunities" %> found
          </p>
        </div>

        <% if (!currentUser) { %>
          <a href="/signup"
             class="text-sm font-semibold text-indigo-600 transition hover:text-indigo-800">
            Join JobNest <span aria-hidden="true">→</span>
          </a>
        <% } %>
      </div>

      <!-- Job Cards -->
      <% if (jobs && jobs.length > 0) { %>
        <div class="mt-7 grid grid-cols-1 gap-5 lg:grid-cols-2">
          <% jobs.forEach((job) => { %>
            <article class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-indigo-200 hover:shadow-xl hover:shadow-indigo-950/5 sm:p-7">

              <!-- Company and Title -->
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-xl font-bold text-indigo-700 ring-1 ring-indigo-100">
                  <%= job.companyName ? job.companyName.charAt(0).toUpperCase() : "J" %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                      <%= job.status || "Active" %>
                    </span>

                    <% if (job.jobType) { %>
                      <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">
                        <%= job.jobType %>
                      </span>
                    <% } %>
                  </div>

                  <h3 class="mt-3 wrap-break-word text-xl font-bold leading-snug text-slate-900 transition group-hover:text-indigo-700">
                    <%= job.title %>
                  </h3>

                  <p class="mt-1 wrap-break-word text-sm font-medium text-slate-600">
                    <%= job.companyName %>
                  </p>
                </div>
              </div>

              <!-- Job Information -->
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500">
                <% if (job.location) { %>
                  <span class="inline-flex items-start gap-1.5">
                    <span aria-hidden="true">📍</span>
                    <span class="wrap-break-word"><%= job.location %></span>
                  </span>
                <% } %>

                <% if (job.workMode) { %>
                  <span class="inline-flex items-center gap-1.5">
                    <span aria-hidden="true">◉</span>
                    <%= job.workMode %>
                  </span>
                <% } %>

                <% if (job.experienceLevel) { %>
                  <span class="inline-flex items-center gap-1.5">
                    <span aria-hidden="true">✦</span>
                    <%= job.experienceLevel %>
                  </span>
                <% } %>
              </div>

              <!-- Description -->
              <% if (job.description) { %>
                <p class="mt-5 wrap-break-word text-sm leading-6 text-slate-600">
                  <%= job.description.length > 150
                    ? job.description.slice(0, 150) + "..."
                    : job.description %>
                </p>
              <% } %>

              <!-- Skills -->
              <% if (job.skills && job.skills.length > 0) { %>
                <div class="mt-5 flex flex-wrap gap-2">
                  <% job.skills.slice(0, 4).forEach((skill) => { %>
                    <span class="max-w-full wrap-break-word rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-600">
                      <%= skill %>
                    </span>
                  <% }) %>

                  <% if (job.skills.length > 4) { %>
                    <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-500">
                      +<%= job.skills.length - 4 %> more
                    </span>
                  <% } %>
                </div>
              <% } %>

              <!-- Salary and Details -->
              <div class="mt-auto pt-6">
                <div class="flex flex-col gap-4 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="min-w-0">
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">
                      Salary
                    </p>
                    <p class="mt-1 wrap-break-word text-base font-bold text-slate-900">
                      <%= job.salary || "Not disclosed" %>
                    </p>
                  </div>

                  <a href="/jobs/<%= job._id %>"
                     class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-600">
                    View job details <span aria-hidden="true">→</span>
                  </a>
                </div>

                <!-- Posting Information -->
                <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
                  <span>
                    <% if (job.postedBy && job.postedBy.fullName) { %>
                      Posted by
                      <span class="font-medium text-slate-500"><%= job.postedBy.fullName %></span>
                    <% } %>
                  </span>

                  <% if (job.createdAt) { %>
                    <span>
                      Posted <%= new Date(job.createdAt).toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                      }) %>
                    </span>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) {
          const paginationParams = {
            ...(category ? { category } : {}),
            ...(type ? { type } : {}),
            ...(location ? { location } : {}),
            ...(sort ? { sort } : {}),
            ...(search ? { search } : {}),
          };
        %>
          <nav class="mt-10 flex flex-wrap items-center justify-center gap-2"
               aria-label="Job listings pagination">

            <% if (currentPage > 1) { %>
              <a href="/jobs?<%= new URLSearchParams({
                ...paginationParams,
                page: String(currentPage - 1)
              }).toString() %>"
                 class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700">
                ← Previous
              </a>
            <% } %>

            <% for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) { %>
              <%
  const pageClasses = currentPage === pageNumber
    ? "border-indigo-600 bg-indigo-600 text-white shadow-md shadow-indigo-600/20"
    : "border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:text-indigo-700";
%>

<a
  href="/jobs?<%= new URLSearchParams({
    ...paginationParams,
    page: String(pageNumber)
  }).toString() %>"
  class="rounded-xl border px-4 py-2.5 text-sm font-semibold transition <%= pageClasses %>"
>
  <%= pageNumber %>
</a>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/jobs?<%= new URLSearchParams({
                ...paginationParams,
                page: String(currentPage + 1)
              }).toString() %>"
                 class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700">
                Next →
              </a>
            <% } %>
          </nav>
        <% } %>

      <% } else { %>

        <!-- Empty State -->
        <div class="mt-7 rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-3xl">
            🔎
          </div>

          <h3 class="mt-5 text-xl font-bold text-slate-900">
            No jobs found
          </h3>

          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
            We couldn't find any opportunities matching these filters.
            Try changing your search or explore all available jobs.
          </p>

          <a href="/jobs"
             class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700">
            Clear filters
          </a>
        </div>

      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>
