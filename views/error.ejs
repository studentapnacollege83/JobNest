
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title><%= statusCode %> | JobNest</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #f8fafc;
      background:
        radial-gradient(ellipse at top, #25245a 0%, transparent 55%),
        #090b16;
      display: flex;
      flex-direction: column;
    }

    nav {
      padding: 22px 7%;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .brand {
      color: white;
      text-decoration: none;
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .brand span { color: #818cf8; }

    main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 20px;
    }

    .card {
      width: 100%;
      max-width: 570px;
      text-align: center;
      padding: 48px 32px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 24px;
      background: rgba(18, 22, 42, .82);
      box-shadow: 0 24px 80px rgba(0,0,0,.3);
    }

    .icon {
      width: 76px;
      height: 76px;
      margin: 0 auto 22px;
      display: grid;
      place-items: center;
      border-radius: 22px;
      background: rgba(129,140,248,.12);
      border: 1px solid rgba(129,140,248,.25);
      color: #a5b4fc;
      font-size: 35px;
    }

    .code {
      margin: 0;
      font-size: clamp(60px, 13vw, 96px);
      line-height: 1;
      font-weight: 900;
      letter-spacing: -5px;
      color: #a5b4fc;
    }

    h1 {
      margin: 22px 0 12px;
      font-size: clamp(23px, 5vw, 30px);
      letter-spacing: -.8px;
    }

    .message {
      margin: 0 auto;
      max-width: 410px;
      color: #a6aec3;
      font-size: 15px;
      line-height: 1.8;
    }

    .actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 20px;
      border-radius: 11px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: .2s ease;
    }

    .primary {
      color: white;
      background: #6366f1;
      border: 1px solid #6366f1;
    }

    .primary:hover { background: #4f46e5; }

    .secondary {
      color: #e2e8f0;
      background: #1e2438;
      border: 1px solid #343b52;
    }

    .secondary:hover { background: #293149; }

    footer {
      padding: 22px;
      text-align: center;
      color: #727b92;
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .card { padding: 38px 20px; }
      .actions { flex-direction: column; }
      .btn { width: 100%; }
    }
  </style>
</head>

<body>
  <nav>
    <a class="brand" href="/">Job<span>Nest</span></a>
  </nav>

  <main>
    <section class="card">
      <div class="icon" aria-hidden="true">
        <%= Number(statusCode) === 404 ? "⌕" : "!" %>
      </div>

      <p class="code"><%= statusCode %></p>

      <h1><%= title %></h1>

      <p class="message"><%= message %></p>

      <div class="actions">
        <a class="btn primary" href="/">Go to Homepage</a>

        <button class="btn secondary" type="button" onclick="goBack()">
          ← Go Back
        </button>
      </div>
    </section>
  </main>

  <footer>
    Crafted with ❤️ by Ankit Sharma
  </footer>

  <script>
    function goBack() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    }
  </script>
</body>
</html>
