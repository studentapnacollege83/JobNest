
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Applications | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-900 text-slate-100">

  <%- include("../partials/navbar") %>

  <main class="min-h-screen bg-slate-900 px-5 py-12 sm:px-8">
    <div class="mx-auto max-w-6xl">

      <a href="/job-seeker/dashboard"
        class="inline-flex items-center font-semibold text-indigo-400 transition hover:text-indigo-300">
        ← Back to Dashboard
      </a>

      <div class="mt-6">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-400">
          Job Seeker
        </p>

        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          My Applications
        </h1>

        <p class="mt-3 text-slate-400">
          Track your applications and check the latest status of each job.
        </p>
      </div>

      <% if (applications.length > 0) { %>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

          <% applications.forEach((application) => { %>

            <% if (application.job) { %>

              <article class="flex flex-col rounded-2xl border border-slate-700 bg-slate-800/80 p-6 shadow-lg transition duration-200 hover:-translate-y-1 hover:border-slate-600 hover:shadow-xl">

                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                      <%= application.job.jobType %>
                    </p>

                    <h2 class="mt-2 break-all text-xl font-bold text-white">
                      <%= application.job.title %>
                    </h2>

                    <p class="mt-2 font-medium text-indigo-400">
                      <%= application.job.companyName %>
                    </p>
                  </div>

                  <% if (application.status === "Hired") { %>
                    <span class="shrink-0 rounded-full border border-emerald-500/40 bg-emerald-500/15 px-3 py-1.5 text-xs font-bold text-emerald-300">
                      Hired 🎉
                    </span>
                  <% } else if (application.status === "Shortlisted") { %>
                    <span class="shrink-0 rounded-full border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 text-xs font-bold text-sky-300">
                      Shortlisted
                    </span>
                  <% } else if (application.status === "Rejected") { %>
                    <span class="shrink-0 rounded-full border border-red-500/40 bg-red-500/15 px-3 py-1.5 text-xs font-bold text-red-300">
                      Rejected
                    </span>
                  <% } else { %>
                    <span class="shrink-0 rounded-full border border-indigo-500/40 bg-indigo-500/15 px-3 py-1.5 text-xs font-bold text-indigo-300">
                      Applied
                    </span>
                  <% } %>
                </div>

                <div class="mt-5 space-y-3 border-t border-slate-700 pt-5 text-sm text-slate-300">

                  <p>
                    <span class="font-semibold text-slate-100">Location:</span>
                    <%= application.job.location %>
                  </p>

                  <p>
                    <span class="font-semibold text-slate-100">Work mode:</span>
                    <%= application.job.workMode %>
                  </p>

                  <p>
                    <span class="font-semibold text-slate-100">Salary:</span>
                    <%= application.job.salary || "Not disclosed" %>
                  </p>

                  <p>
                    <span class="font-semibold text-slate-100">Applied on:</span>
                    <%= new Date(application.createdAt).toLocaleDateString("en-IN") %>
                  </p>

                </div>

                <% if (application.status === "Hired") { %>

                  <div class="mt-5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4">
                    <p class="text-sm font-bold text-emerald-300">
                      🎉 Congratulations! You've been selected.
                    </p>
                    <p class="mt-2 text-sm leading-6 text-emerald-100/80">
                      The employer has hired you for this position. Check your joining details below.
                    </p>
                  </div>

                  <% if (application.hiringDetails) { %>
                    <div class="mt-4 rounded-xl border border-slate-700 bg-slate-900/70 p-4">
                      <h3 class="font-bold text-white">
                        Your Hiring Details
                      </h3>

                      <div class="mt-4 space-y-3 text-sm text-slate-300">

                        <% if (application.hiringDetails.joiningDate) { %>
                          <p>
                            <span class="font-semibold text-slate-100">Joining date:</span>
                            <%= new Date(application.hiringDetails.joiningDate).toLocaleDateString("en-IN", { timeZone: "UTC" }) %>
                          </p>
                        <% } %>

                        <% if (application.hiringDetails.reportingTime) { %>
                          <p>
                            <span class="font-semibold text-slate-100">Reporting time:</span>
                            <%= application.hiringDetails.reportingTime %>
                          </p>
                        <% } %>

                        <% if (application.hiringDetails.joiningLocation) { %>
                          <p>
                            <span class="font-semibold text-slate-100">Joining location:</span>
                            <%= application.hiringDetails.joiningLocation %>
                          </p>
                        <% } %>

                        <% if (application.hiringDetails.salary) { %>
                          <p>
                            <span class="font-semibold text-slate-100">Offered salary:</span>
                            <%= application.hiringDetails.salary %>
                          </p>
                        <% } %>

                        <% if (application.hiringDetails.contactPerson) { %>
                          <p>
                            <span class="font-semibold text-slate-100">Contact person:</span>
                            <%= application.hiringDetails.contactPerson %>
                          </p>
                        <% } %>

                        <% if (application.hiringDetails.instructions) { %>
                          <div class="border-t border-slate-700 pt-3">
                            <p class="font-semibold text-slate-100">Instructions:</p>
                            <p class="mt-1 whitespace-pre-line leading-6 text-slate-300"><%= application.hiringDetails.instructions %></p>
                          </div>
                        <% } %>

                      </div>
                    </div>
                  <% } %>

                <% } else if (application.status === "Shortlisted") { %>

                  <div class="mt-5 rounded-xl border border-sky-500/20 bg-sky-500/10 p-4">
                    <p class="text-sm font-semibold text-sky-300">
                      Your application has been shortlisted.
                    </p>
                    <p class="mt-1 text-xs leading-5 text-sky-200/80">
                      The employer may contact you with the next steps.
                    </p>
                  </div>

                <% } else if (application.status === "Rejected") { %>

                  <div class="mt-5 rounded-xl border border-red-500/20 bg-red-500/10 p-4">
                    <p class="text-sm font-semibold text-red-300">
                      This application was rejected.
                    </p>
                    <p class="mt-1 text-xs leading-5 text-red-200/80">
                      Keep exploring other opportunities on JobNest.
                    </p>
                  </div>

                <% } else { %>

                  <div class="mt-5 rounded-xl border border-indigo-500/20 bg-indigo-500/10 p-4">
                    <p class="text-sm font-semibold text-indigo-300">
                      Application submitted successfully.
                    </p>
                    <p class="mt-1 text-xs leading-5 text-indigo-200/80">
                      Your application is awaiting an employer decision.
                    </p>
                  </div>

                <% } %>

                <div class="mt-auto pt-5">
                  <a
                    href="/jobs/<%= application.job._id %>"
                    class="inline-flex w-full items-center justify-center rounded-xl border border-slate-600 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-indigo-500 hover:bg-indigo-500/10 hover:text-indigo-300"
                  >
                    View Job Details →
                  </a>
                </div>

              </article>

            <% } %>

          <% }) %>

        </div>

      <% } else { %>

        <div class="mt-8 rounded-2xl border border-dashed border-slate-700 bg-slate-800/60 px-6 py-14 text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500/15 text-3xl">
            💼
          </div>

          <h2 class="mt-4 text-xl font-bold text-white">
            No applications yet
          </h2>

          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-400">
            You haven't applied for any jobs yet. Explore opportunities and submit your first application.
          </p>

          <a
            href="/jobs"
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 font-semibold text-white transition hover:bg-indigo-500"
          >
            Explore Jobs →
          </a>
        </div>

      <% } %>

    </div>
  </main>

  <%- include("../partials/footer") %>

</body>
</html>
