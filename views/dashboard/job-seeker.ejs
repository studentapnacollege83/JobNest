
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Seeker Dashboard | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-8 sm:py-12">

    <!-- Welcome Banner -->
    <section class="relative overflow-hidden rounded-3xl border border-indigo-400/20  bg-linear-to-br from-indigo-950 via-slate-900 to-violet-950 p-7 shadow-2xl sm:p-10">
      <div class="pointer-events-none absolute -right-12 -top-16 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

      <div class="relative">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-indigo-300 sm:text-sm">
          Job Seeker Dashboard
        </p>

        <h1 class="mt-4 wrap-break-word text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Welcome back, <%= user.fullName %>!
        </h1>

        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
          Your next opportunity could be one application away. Track your progress,
          manage your resume, and keep moving toward your career goals.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/jobs"
             class="inline-flex items-center justify-center rounded-xl bg-indigo-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-950/40 transition hover:bg-indigo-400">
            Explore Jobs <span class="ml-2">→</span>
          </a>

          <a href="/job-seeker/applications"
             class="inline-flex items-center justify-center rounded-xl border border-slate-600 bg-slate-900/60 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-indigo-400 hover:bg-slate-800">
            My Applications
          </a>
        </div>
      </div>
    </section>

    <!-- Application Statistics -->
    <section class="mt-8">
      <div class="mb-4">
        <h2 class="text-xl font-bold text-white">Your Activity</h2>
        <p class="mt-1 text-sm text-slate-400">A quick overview of your job search progress.</p>
      </div>

      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">

        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-indigo-500/50">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-500/15 text-xl">
            📋
          </div>
          <p class="mt-4 text-sm font-medium text-slate-400">Total Applications</p>
          <p class="mt-1 text-3xl font-extrabold text-white"><%= totalApplications %></p>
          <p class="mt-2 text-xs text-slate-500">Jobs you've applied to</p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-sky-500/50">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-500/15 text-xl">
            🎯
          </div>
          <p class="mt-4 text-sm font-medium text-slate-400">Shortlisted</p>
          <p class="mt-1 text-3xl font-extrabold text-sky-300"><%= shortlistedApplications %></p>
          <p class="mt-2 text-xs text-slate-500">Applications shortlisted</p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-emerald-500/50">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-xl">
            🏆
          </div>
          <p class="mt-4 text-sm font-medium text-slate-400">Hired</p>
          <p class="mt-1 text-3xl font-extrabold text-emerald-300"><%= hiredApplications %></p>
          <p class="mt-2 text-xs text-slate-500">Successful applications</p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-red-500/50">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-500/15 text-xl">
            📌
          </div>
          <p class="mt-4 text-sm font-medium text-slate-400">Rejected</p>
          <p class="mt-1 text-3xl font-extrabold text-red-300"><%= rejectedApplications %></p>
          <p class="mt-2 text-xs text-slate-500">Applications declined</p>
        </div>

      </div>
    </section>

    <!-- Main Dashboard Sections -->
    <section class="mt-8 grid gap-6 lg:grid-cols-2">

      <!-- Resume Management -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-indigo-400">
              Profile Essentials
            </p>
            <h2 class="mt-2 text-xl font-bold text-white">Resume Management</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Keep your resume updated so employers can review your qualifications.
            </p>
          </div>

          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-500/15 text-2xl">
            📄
          </div>
        </div>

        <% if (user.resume && user.resume.filename) { %>
          <div class="mt-5 rounded-xl border border-emerald-500/25 bg-emerald-500/10 p-4">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <p class="font-semibold text-emerald-300">Resume uploaded</p>
            </div>
            <p class="mt-2 break-all text-sm text-slate-300">
              <%= user.resume.originalName %>
            </p>
            <p class="mt-1 text-xs text-slate-400">
              You can upload a new PDF to replace your current resume.
            </p>
          </div>
        <% } else { %>
          <div class="mt-5 rounded-xl border border-amber-500/20 bg-amber-500/10 p-4">
            <p class="font-semibold text-amber-300">Resume not uploaded yet</p>
            <p class="mt-1 text-sm text-slate-400">
              Upload your PDF resume to help employers review your profile.
            </p>
          </div>
        <% } %>

        <% if (resumeUploaded) { %>
          <p class="mt-3 text-sm font-medium text-emerald-300">
            ✓ Resume uploaded successfully!
          </p>
        <% } %>

        <form action="/job-seeker/resume"
              method="POST"
              enctype="multipart/form-data"
              class="mt-5 space-y-4">

          <div>
            <label for="resume" class="mb-2 block text-sm font-semibold text-slate-200">
              Select resume (PDF, max 2 MB)
            </label>

            <input
              id="resume"
              type="file"
              name="resume"
              accept=".pdf,application/pdf"
              required
              class="block w-full rounded-xl border border-slate-700 bg-slate-950 p-3 text-sm text-slate-300 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-500/15 file:px-4 file:py-2 file:font-semibold file:text-indigo-300"
            >
          </div>

          <button type="submit"
                  class="w-full rounded-xl bg-indigo-500 px-5 py-3 font-bold text-white transition hover:bg-indigo-400">
            <%= user.resume && user.resume.filename ? "Replace Resume" : "Upload Resume" %>
          </button>
        </form>
      </div>

      <!-- Applications -->
      <div class="flex flex-col rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-400">
              Career Progress
            </p>
            <h2 class="mt-2 text-xl font-bold text-white">My Applications</h2>
          </div>

          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-2xl">
            📬
          </div>
        </div>

        <p class="mt-3 text-sm leading-7 text-slate-400">
          Check application statuses, see which employers shortlisted you,
          and view your hiring details when you're selected.
        </p>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="text-xs text-slate-500">Awaiting a decision</p>
            <p class="mt-2 text-2xl font-bold text-indigo-300">
              <%= Math.max(0, totalApplications - shortlistedApplications - hiredApplications - rejectedApplications) %>
            </p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="text-xs text-slate-500">Resume status</p>
            <p class="mt-2 text-sm font-bold <%= user.resume && user.resume.filename ? 'text-emerald-300' : 'text-amber-300' %>">
              <%= user.resume && user.resume.filename ? "Ready ✓" : "Pending" %>
            </p>
          </div>
        </div>

        <div class="mt-auto pt-6">
          <a href="/job-seeker/applications"
             class="inline-flex w-full items-center justify-center rounded-xl border border-slate-700 bg-slate-800 px-5 py-3 font-semibold text-slate-100 transition hover:border-indigo-500 hover:bg-slate-700">
            View All Applications <span class="ml-2">→</span>
          </a>
        </div>
      </div>

    </section>

    <!-- Explore Jobs -->
    <section class="mt-8 rounded-2xl border border-slate-800 bg-linear-to-r from-slate-900 to-indigo-950/50 p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-indigo-400">
            Keep Moving Forward
          </p>
          <h2 class="mt-2 text-xl font-bold text-white sm:text-2xl">
            Ready for your next opportunity?
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
            Explore jobs and internships posted by employers on JobNest.
            Your next step could be closer than you think.
          </p>
        </div>

        <a href="/jobs"
           class="inline-flex shrink-0 items-center justify-center rounded-xl bg-indigo-500 px-5 py-3 font-bold text-white transition hover:bg-indigo-400">
          Browse Opportunities →
        </a>
      </div>
    </section>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>
