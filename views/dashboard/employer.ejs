
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employer Dashboard | JobNest</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">

    <!-- Dashboard Header -->
    <section class="relative overflow-hidden rounded-3xl border border-indigo-400/20 bg-linear-to-br from-indigo-950 via-slate-900 to-violet-950 p-6 shadow-2xl sm:p-10">
      <div class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

      <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-indigo-300">
            Employer Workspace
          </p>

          <h1 class="mt-3 wrap-break-word text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Welcome, <%= user.fullName %>!
          </h1>

          <p class="mt-3 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
            Manage your job postings, track applications, and find the right talent for your team.
          </p>
        </div>

        <a
          href="/employer/jobs/new"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-indigo-500 px-5 py-3 font-semibold text-white shadow-lg shadow-indigo-950/40 transition hover:bg-indigo-400"
        >
          <span class="text-xl">+</span> Post a Job
        </a>
      </div>
    </section>

    <!-- Statistics -->
    <section class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

      <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-indigo-500/40">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-400">Total Jobs</p>
          <span class="flex size-10 items-center justify-center rounded-xl bg-indigo-500/10 text-xl text-indigo-300">▤</span>
        </div>
        <p class="mt-5 text-3xl font-bold text-white"><%= totalJobs %></p>
        <p class="mt-1 text-xs text-slate-500">All your job postings</p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-emerald-500/40">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-400">Active Jobs</p>
          <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-500/10 text-xl text-emerald-300">✓</span>
        </div>
        <p class="mt-5 text-3xl font-bold text-emerald-400"><%= activeJobs %></p>
        <p class="mt-1 text-xs text-slate-500">Currently accepting applications</p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-amber-500/40">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-400">Closed Jobs</p>
          <span class="flex size-10 items-center justify-center rounded-xl bg-amber-500/10 text-xl text-amber-300">◷</span>
        </div>
        <p class="mt-5 text-3xl font-bold text-amber-400"><%= closedJobs %></p>
        <p class="mt-1 text-xs text-slate-500">No longer publicly listed</p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-violet-500/40">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-slate-400">Total Applications</p>
          <span class="flex size-10 items-center justify-center rounded-xl bg-violet-500/10 text-xl text-violet-300">♧</span>
        </div>
        <p class="mt-5 text-3xl font-bold text-violet-300"><%= totalApplications %></p>
        <p class="mt-1 text-xs text-slate-500">Applications across your jobs</p>
      </div>

    </section>

    <!-- Quick Actions -->
    <section class="mt-7 grid gap-4 sm:grid-cols-2">

      <a
        href="/employer/jobs/new"
        class="group rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-indigo-500/50 hover:bg-slate-900/90 sm:p-6"
      >
        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-indigo-500/10 text-2xl text-indigo-300 transition group-hover:bg-indigo-500/20">+</div>
          <div>
            <h2 class="font-bold text-white transition group-hover:text-indigo-300">Create a Job</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Publish a new job or internship opportunity.</p>
            <p class="mt-3 text-sm font-semibold text-indigo-300">Post opportunity →</p>
          </div>
        </div>
      </a>

      <a
        href="/employer/applicants"
        class="group rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-emerald-500/40 hover:bg-slate-900/90 sm:p-6"
      >
        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-2xl">👥</div>
          <div>
            <h2 class="font-bold text-white transition group-hover:text-emerald-300">Manage Applicants</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Review candidates and manage their application status.</p>
            <p class="mt-3 text-sm font-semibold text-emerald-300">View candidates →</p>
          </div>
        </div>
      </a>

    </section>

    <!-- Job Postings -->
    <section class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/70 p-5 shadow-xl sm:p-7">

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-bold text-white sm:text-2xl">Your Job Postings</h2>
          <p class="mt-2 text-sm text-slate-400">Manage your opportunities and review their current status.</p>
        </div>

        <span class="w-fit rounded-full border border-indigo-400/20 bg-indigo-500/10 px-3 py-1.5 text-sm font-semibold text-indigo-300">
          <%= totalJobs %> Jobs Posted
        </span>
      </div>

      <div class="mt-6 space-y-4">

        <% if (jobs && jobs.length > 0) { %>

          <% jobs.forEach((job) => { %>

            <article class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5 transition hover:border-slate-700 sm:p-6">

              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

                <div class="min-w-0">
                  <h3 class="wrap-break-word text-lg font-bold text-white sm:text-xl">
                    <%= job.title %>
                  </h3>

                  <p class="mt-2 wrap-break-word text-sm text-slate-400">
                    <%= job.companyName %> <span class="px-1 text-slate-600">·</span> <%= job.location %>
                  </p></div>           
<span class="w-fit shrink-0 rounded-full border border-emerald-400/20 px-3 py-1 text-xs font-semibold text-emerald-300" style="background-color: #064e3b;">
  <%= job.status %>
</span>


              </div>

              <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium sm:text-sm">
                <span class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-slate-300"><%= job.jobType %></span>
                <span class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-slate-300"><%= job.workMode %></span>
                <span class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-slate-300"><%= job.experienceLevel %></span>
                <span class="rounded-lg border border-indigo-400/20 bg-indigo-500/10 px-3 py-2 text-indigo-300"><%= job.salary || "Not disclosed" %></span>
              </div>

              <p class="mt-5 wrap-break-word whitespace-pre-line text-sm leading-7 text-slate-400"><%= job.description %></p>

              <% if (job.skills && job.skills.length > 0) { %>
                <div class="mt-4 flex flex-wrap gap-2">
                  <% job.skills.forEach((skill) => { %>
                    <span class="rounded-md border border-slate-800 bg-slate-900 px-2.5 py-1 text-xs text-slate-300"><%= skill %></span>
                  <% }); %>
                </div>
              <% } %>

              <div class="mt-5 flex flex-col gap-3 border-t border-slate-800 pt-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs text-slate-500">
                  Posted on <%= new Date(job.createdAt).toLocaleDateString("en-IN") %>
                </p>

                <div class="flex flex-wrap gap-2">

                  <a
                    href="/jobs/<%= job._id %>"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:border-indigo-400/50 hover:bg-indigo-500/10 hover:text-indigo-300">
                    View Details →
                  </a>                 
<a
  href="/employer/jobs/<%= job._id %>/edit"
  class="inline-flex items-center justify-center rounded-lg border border-indigo-400/30 bg-indigo-500/10 px-4 py-2 text-sm font-semibold text-indigo-300 transition hover:bg-indigo-500/20">
  Edit Job
</a>

<form
  action="/employer/jobs/<%= job._id %>/delete"
  method="POST"
  onsubmit="return confirm('Delete this job? It will disappear from your dashboard and public listings. Existing applications will be preserved.');"
>
  <button
    type="submit"
    class="inline-flex items-center justify-center rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-red-500/20"
  >
    Delete Job
  </button>
</form>

                  <% if (job.status === "Active") { %>
                    <form
                      action="/employer/jobs/<%= job._id %>/close"
                      method="POST"
                      onsubmit="return confirm('Close this job? It will no longer appear in public job listings. Existing applications will be preserved.');"
                    >
                      <button
                        type="submit"
                        class="inline-flex items-center justify-center rounded-lg border border-red-400/20 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-red-500/10"
                      >
                        Close Job
                      </button>
                    </form>
                  <% } %>

                </div>
              </div>

            </article>

          <% }); %>

        <% } else { %>

          <div class="rounded-2xl border border-dashed border-slate-700 px-5 py-14 text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-indigo-400/20 bg-indigo-500/10 text-3xl text-indigo-300">+</div>

            <h3 class="mt-4 font-bold text-white">No jobs posted yet</h3>

            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-400">
              Your hiring journey starts here. Publish your first opportunity to connect with potential candidates.
            </p>

            <a
              href="/employer/jobs/new"
              class="mt-5 inline-flex items-center justify-center rounded-xl bg-indigo-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-400"
            >
              Create Your First Job →
            </a>
          </div>

        <% } %>

      </div>
    </section>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>
